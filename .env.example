# ─── Upstash Redis (free tier) ────────────────────────────────────────────────
# Get from https://console.upstash.com → create a Redis database
UPSTASH_REDIS_REST_URL=https://YOUR-INSTANCE.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXXXXXxxxxxx

# ─── Supabase (free tier) ─────────────────────────────────────────────────────
# Get from https://supabase.com → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Cloudflare Worker media proxy ───────────────────────────────────────────
# HMAC secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match the value set as a Worker secret: npx wrangler secret put PROXY_HMAC_SECRET
PROXY_HMAC_SECRET=change-me-to-64-hex-chars-here

# Full URL of your deployed Cloudflare Worker (after: npm run worker:deploy)
PROXY_BASE_URL=https://vibview-proxy.YOUR-CF-SUBDOMAIN.workers.dev

# ─── Data providers ───────────────────────────────────────────────────────────
# TikHub API key — get from https://tikhub.io → Dashboard → API Keys
TIKHUB_API_KEY=

# tikwm.com API token — register at https://tikwm.com to get one.
# When set, bypasses Cloudflare checks (no cf_clearance needed).
TIKWM_API_TOKEN=

# tikwm.com Cloudflare clearance cookie — fallback if you have no API token.
# 1. Open https://tikwm.com in Chrome/Firefox
# 2. DevTools → Application → Cookies → tikwm.com → copy "cf_clearance" value
# Lasts ~1 hour — refresh when you see 403 errors in provider logs.
TIKWM_CF_CLEARANCE=

# TikTok session ID — improves scrape provider reliability (optional).
# DevTools → Application → Cookies → tiktok.com → "sessionid"
TIKTOK_SESSION_ID=

# ─── Email (Resend free tier — 3 000 emails/month) ────────────────────────────
# Get from https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cron security ────────────────────────────────────────────────────────────
# Secret header value for the /api/snapshot cron endpoint.
# Set the same value as the "Authorization" secret in Vercel Cron settings.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SNAPSHOT_SECRET=change-me
